<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    


		<bean id="emp"  class="com.hexaware.springxml.bean.Employee">
		
			<property name="eid" value="101"></property>
			<property name="ename" value="king"></property>
			<property name="salary"  value="90000"></property>
			<property name="address"  ref="a1"></property>
		
		
		</bean>


	<bean id="a1"  class="com.hexaware.springxml.bean.Address">
	
	
		<constructor-arg  name="city"  value="Hyderabad"></constructor-arg>
	
	
	</bean>




</beans>